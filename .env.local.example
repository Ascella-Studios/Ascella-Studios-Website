# HubSpot Integration
# Get your private app token from: https://app.hubspot.com/private-apps/
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.lists.read, crm.lists.write, crm.schemas.contacts.read, crm.schemas.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here

# Optional: extra HubSpot list IDs /api/waitlist may add contacts to, comma-separated.
# List 13 (studio updates) is always allowed; see src/lib/waitlist.ts.
WAITLIST_EXTRA_LIST_IDS=
